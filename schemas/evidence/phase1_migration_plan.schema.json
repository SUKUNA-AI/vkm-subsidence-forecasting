{
  "$defs": {
    "ArchivedRow": {
      "additionalProperties": false,
      "properties": {
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "old_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Old Id"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "row_number": {
          "minimum": 1,
          "title": "Row Number",
          "type": "integer"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "path",
        "file_sha256",
        "row_number",
        "old_id",
        "values"
      ],
      "title": "ArchivedRow",
      "type": "object"
    },
    "CatalogueSpec": {
      "additionalProperties": false,
      "description": "Explicit column mapping, never a guess from a filename or cell contents.\n\nstatement_column=None deliberately archives otherwise unmappable catalogues\nas UNRESOLVED. Source/locator fields may contain multiple old references; the\nexact old locator string remains in the row, while owner bindings resolve it.",
      "properties": {
        "evidence_type_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "evidence_type",
          "title": "Evidence Type Column"
        },
        "id_column": {
          "title": "Id Column",
          "type": "string"
        },
        "inputs_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Column"
        },
        "locator_column": {
          "default": "locator",
          "title": "Locator Column",
          "type": "string"
        },
        "method_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Column"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "quote_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "quote",
          "title": "Quote Column"
        },
        "rationale_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale Column"
        },
        "scale_column": {
          "default": "scale",
          "title": "Scale Column",
          "type": "string"
        },
        "scope_column": {
          "default": "scope",
          "title": "Scope Column",
          "type": "string"
        },
        "source_column": {
          "default": "source_id",
          "title": "Source Column",
          "type": "string"
        },
        "statement_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "quote",
          "title": "Statement Column"
        },
        "status_column": {
          "default": "status",
          "title": "Status Column",
          "type": "string"
        }
      },
      "required": [
        "path",
        "id_column"
      ],
      "title": "CatalogueSpec",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "title": "Depends On",
          "type": "array"
        },
        "kind": {
          "const": "CLAIM",
          "default": "CLAIM",
          "title": "Kind",
          "type": "string"
        },
        "modality": {
          "enum": [
            "OBSERVED",
            "REPORTED",
            "HYPOTHESIZED",
            "PLANNED",
            "NORMATIVE",
            "UNKNOWN"
          ],
          "title": "Modality",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "AFFIRMED",
            "NEGATED",
            "UNCERTAIN"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/ResourcePolicy"
        },
        "proposition": {
          "minLength": 1,
          "title": "Proposition",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "qualifiers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "array"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
          "title": "Record Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "title": "References",
          "type": "array"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState",
          "default": "UNREVIEWED"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "vkm-evidence/1",
          "default": "vkm-evidence/1",
          "title": "Schema Version",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "supports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Supports",
          "type": "array"
        },
        "time": {
          "$ref": "#/$defs/TemporalSupport"
        }
      },
      "required": [
        "record_id",
        "recorded_at",
        "actor",
        "policy",
        "proposition",
        "attribution",
        "polarity",
        "modality",
        "provenance"
      ],
      "title": "Claim",
      "type": "object"
    },
    "DataAccessClass": {
      "enum": [
        "PUBLIC",
        "PRIVATE_CLOUD_ALLOWED",
        "PRIVATE_LOCAL_ONLY",
        "RESTRICTED",
        "SEALED"
      ],
      "title": "DataAccessClass",
      "type": "string"
    },
    "EpistemicStatus": {
      "enum": [
        "FACT",
        "DERIVATION",
        "INTERPOLATION",
        "MODEL_CHOICE",
        "ENGINEERING_ASSUMPTION",
        "ANALOGUE",
        "UNKNOWN"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "MEASURED",
        "FIELD_OBSERVATION",
        "LAB_TEST",
        "NORMATIVE",
        "DESIGN_VALUE",
        "CALCULATED_BY_AUTHOR",
        "MODEL_CALIBRATED",
        "TEACHING_EXAMPLE",
        "LITERATURE_CITED",
        "INTERPRETATION",
        "DESCRIPTIVE",
        "COMPUTED_THIS_PROJECT",
        "NOT_APPLICABLE"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "ExperimentalRole": {
      "enum": [
        "INPUT",
        "CALIBRATION",
        "VALIDATION",
        "TEST_SEALED",
        "TARGET",
        "UNKNOWN"
      ],
      "title": "ExperimentalRole",
      "type": "string"
    },
    "FrozenCatalogue": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "items": {
            "type": "string"
          },
          "title": "Header",
          "type": "array"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "spec": {
          "$ref": "#/$defs/CatalogueSpec"
        }
      },
      "required": [
        "spec",
        "sha256",
        "size_bytes",
        "header",
        "row_count"
      ],
      "title": "FrozenCatalogue",
      "type": "object"
    },
    "FrozenMigrationInputs": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "$ref": "#/$defs/MigrationBounds"
        },
        "catalogue_policy": {
          "$ref": "#/$defs/ResourcePolicy"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FrozenCatalogue"
          },
          "title": "Files",
          "type": "array"
        },
        "schema_version": {
          "const": "vkm-phase1-migration-inputs/1",
          "default": "vkm-phase1-migration-inputs/1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "files",
        "catalogue_policy",
        "bounds"
      ],
      "title": "FrozenMigrationInputs",
      "type": "object"
    },
    "MigrationBounds": {
      "additionalProperties": false,
      "properties": {
        "max_cell_chars": {
          "default": 100000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Cell Chars",
          "type": "integer"
        },
        "max_columns": {
          "default": 512,
          "maximum": 2048,
          "minimum": 1,
          "title": "Max Columns",
          "type": "integer"
        },
        "max_files": {
          "default": 32,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_rows": {
          "default": 2048,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 8388608,
          "maximum": 16777216,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
        }
      },
      "title": "MigrationBounds",
      "type": "object"
    },
    "MigrationRow": {
      "additionalProperties": false,
      "properties": {
        "historical_quote_field": {
          "default": "UNSPECIFIED",
          "enum": [
            "VERBATIM",
            "PARAPHRASE",
            "UNSPECIFIED",
            "NONE"
          ],
          "title": "Historical Quote Field",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "MIGRATABLE",
            "UNRESOLVED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Claim"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "row_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Row Sha256",
          "type": "string"
        },
        "semantic_state": {
          "const": "NEEDS_SEMANTIC_REVIEW",
          "default": "NEEDS_SEMANTIC_REVIEW",
          "title": "Semantic State",
          "type": "string"
        }
      },
      "required": [
        "row_sha256",
        "outcome",
        "reasons"
      ],
      "title": "MigrationRow",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "extraction_generation": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Extraction Generation",
          "type": "string"
        },
        "fragment_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragment Sha256"
        },
        "locator": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Object Version",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_sha256",
        "snapshot_id",
        "object_id",
        "object_version",
        "content_sha256",
        "locator",
        "extraction_generation"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": "UNSTATED",
          "title": "Confidence",
          "type": "string"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType",
          "default": "NOT_APPLICABLE"
        },
        "inputs": {
          "default": [],
          "description": "ids of WorldSpec items this was derived/interpolated from",
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "derivation / interpolation method",
          "title": "Method"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "mandatory for MODEL_CHOICE / ENGINEERING_ASSUMPTION",
          "title": "Rationale"
        },
        "scale": {
          "$ref": "#/$defs/Scale",
          "default": "UNSTATED"
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "default": "UNSTATED"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "spatial": {
          "$ref": "#/$defs/SpatialSupport"
        },
        "status": {
          "$ref": "#/$defs/EpistemicStatus"
        },
        "temporal": {
          "$ref": "#/$defs/TemporalSupport"
        },
        "transfer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transfer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ResourcePolicy": {
      "additionalProperties": false,
      "properties": {
        "access_class": {
          "$ref": "#/$defs/DataAccessClass",
          "default": "RESTRICTED"
        },
        "authority": {
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "experimental_role": {
          "$ref": "#/$defs/ExperimentalRole",
          "default": "UNKNOWN"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "restrictions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        }
      },
      "required": [
        "policy_version",
        "authority"
      ],
      "title": "ResourcePolicy",
      "type": "object"
    },
    "ReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        },
        "decision": {
          "enum": [
            "VERIFIED_TRANSCRIPTION",
            "SEMANTIC_REVIEWED",
            "CONFLICT",
            "REJECTED",
            "REVOKED"
          ],
          "title": "Decision",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "title": "Depends On",
          "type": "array"
        },
        "kind": {
          "const": "REVIEW_DECISION",
          "default": "REVIEW_DECISION",
          "title": "Kind",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/ResourcePolicy"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
          "title": "Record Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "title": "References",
          "type": "array"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState",
          "default": "UNREVIEWED"
        },
        "reviewer_authority": {
          "minLength": 1,
          "title": "Reviewer Authority",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "vkm-evidence/1",
          "default": "vkm-evidence/1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_verified": {
          "default": false,
          "title": "Source Verified",
          "type": "boolean"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "supports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Supports",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/VersionRef"
        },
        "time": {
          "$ref": "#/$defs/TemporalSupport"
        }
      },
      "required": [
        "record_id",
        "recorded_at",
        "actor",
        "policy",
        "target",
        "decision",
        "rationale",
        "reviewer_authority"
      ],
      "title": "ReviewDecision",
      "type": "object"
    },
    "ReviewState": {
      "enum": [
        "UNREVIEWED",
        "VERIFIED_TRANSCRIPTION",
        "SEMANTIC_REVIEWED",
        "CONFLICT",
        "REJECTED"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "RowBinding": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "historical_quote_field": {
          "default": "UNSPECIFIED",
          "enum": [
            "VERBATIM",
            "PARAPHRASE",
            "UNSPECIFIED",
            "NONE"
          ],
          "title": "Historical Quote Field",
          "type": "string"
        },
        "row_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Row Sha256",
          "type": "string"
        },
        "supports": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Supports",
          "type": "array"
        }
      },
      "required": [
        "row_sha256",
        "supports"
      ],
      "title": "RowBinding",
      "type": "object"
    },
    "Scale": {
      "enum": [
        "LAB",
        "MASSIF",
        "CALIBRATED_EFFECTIVE_MODEL",
        "FIELD",
        "DESIGN",
        "NOT_APPLICABLE",
        "UNSTATED"
      ],
      "title": "Scale",
      "type": "string"
    },
    "Scope": {
      "description": "Site scope of a datum. Only SKRU1 is field-wide site-specific for SKRU-1.\n\nThe SKRU-1/SKRU-2 joint labels are kept apart (review finding TRANSFER-023):\n``SKRU1_SKRU2_PILLAR`` — the intermine pillar zone on the SKRU-1/SKRU-2 boundary (usable for SKRU-1 only locally,\nat the pillar, or through an explicit Transfer); ``SKRU1_OR_SKRU2_UNATTRIBUTED`` — the source does not say which\nof the two mines; ``SOLIKAMSK_GROUP`` — pooled over SKRU-1, SKRU-2 and SKRU-3. ``SKRU1_SKRU2`` is the legacy\nambiguous label of the first Phase-1 catalogues; it is valid but never counts as SKRU-1 data.",
      "enum": [
        "SKRU1",
        "SKRU1_SKRU2_PILLAR",
        "SKRU1_OR_SKRU2_UNATTRIBUTED",
        "SOLIKAMSK_GROUP",
        "SKRU1_SKRU2",
        "SKRU2",
        "SKRU3",
        "BKPRU1",
        "BKPRU2",
        "BKPRU3",
        "BKPRU4",
