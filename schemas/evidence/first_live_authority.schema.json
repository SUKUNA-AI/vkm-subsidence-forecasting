{
  "$defs": {
    "BoundFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "BoundFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_generation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Generation Sha256",
      "type": "string"
    },
    "capability": {
      "const": "INITIALIZE_NORMAL_GENERATION_ONCE",
      "default": "INITIALIZE_NORMAL_GENERATION_ONCE",
      "title": "Capability",
      "type": "string"
    },
    "control_root": {
      "title": "Control Root",
      "type": "string"
    },
    "fallback": {
      "const": "LEGACY_RESTORED_UNQUALIFIED_CLOSED",
      "default": "LEGACY_RESTORED_UNQUALIFIED_CLOSED",
      "title": "Fallback",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/BoundFile"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "vkm-first-live-authority/1",
      "default": "vkm-first-live-authority/1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "intent",
    "request_id",
    "control_root",
    "candidate_generation_sha256"
  ],
  "title": "LiveAdmissionAuthority",
  "type": "object"
}
