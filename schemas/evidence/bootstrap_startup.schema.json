{
  "$defs": {
    "CandidatePin": {
      "additionalProperties": false,
      "properties": {
        "access_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Access Config Sha256",
          "type": "string"
        },
        "code_commit": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Code Commit",
          "type": "string"
        },
        "code_tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Tree Sha256",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentIdentity"
          },
          "title": "Components",
          "type": "array"
        },
        "dependencies_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependencies Sha256",
          "type": "string"
        },
        "duckdb_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Duckdb File Sha256",
          "type": "string"
        },
        "nav_file_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nav File Sha256"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "services": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ServiceIdentity"
          },
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "code_commit",
        "code_tree_sha256",
        "dependencies_sha256",
        "access_config_sha256",
        "policy_sha256",
        "duckdb_file_sha256",
        "components"
      ],
      "title": "CandidatePin",
      "type": "object"
    },
    "ComponentIdentity": {
      "additionalProperties": false,
      "properties": {
        "built_from": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Built From",
          "type": "object"
        },
        "component": {
          "enum": [
            "DOCUMENT",
            "DATASET",
            "EVIDENCE",
            "DUCKDB",
            "NAV",
            "GRAPH",
            "SEARCH",
            "DENSE",
            "LATE",
            "VISUAL"
          ],
          "title": "Component",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "component",
        "revision",
        "manifest_sha256",
        "policy_sha256",
        "built_from"
      ],
      "title": "ComponentIdentity",
      "type": "object"
    },
    "ServiceIdentity": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "dependencies_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependencies Sha256",
          "type": "string"
        },
        "endpoint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Sha256",
          "type": "string"
        },
        "instance_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Instance Sha256",
          "type": "string"
        },
        "resources": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "title": "Resources",
          "type": "object"
        },
        "runtime_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Sha256",
          "type": "string"
        },
        "service": {
          "enum": [
            "RETRIEVAL",
            "RERANK",
            "CONTROL"
          ],
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service",
        "instance_sha256",
        "code_sha256",
        "dependencies_sha256",
        "config_sha256",
        "endpoint_sha256",
        "runtime_sha256"
      ],
      "title": "ServiceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bootstrap_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
      "title": "Bootstrap Id",
      "type": "string"
    },
    "candidate": {
      "$ref": "#/$defs/CandidatePin"
    },
    "control_root": {
      "minLength": 1,
      "title": "Control Root",
      "type": "string"
    },
    "independent_backup_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Independent Backup Sha256",
      "type": "string"
    },
    "isolation_attestation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Isolation Attestation Sha256",
      "type": "string"
    },
    "legacy_topology_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Legacy Topology Sha256",
      "type": "string"
    },
    "mode": {
      "const": "SHADOW_CLOSED_METADATA",
      "default": "SHADOW_CLOSED_METADATA",
      "title": "Mode",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "vkm-bootstrap-startup/1",
      "default": "vkm-bootstrap-startup/1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "bootstrap_id",
    "request_id",
    "candidate",
    "control_root",
    "isolation_attestation_sha256",
    "legacy_topology_sha256",
    "independent_backup_sha256"
  ],
  "title": "BootstrapStartupAuthority",
  "type": "object"
}
