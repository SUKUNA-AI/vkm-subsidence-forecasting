{
  "$defs": {
    "BoundFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "BoundFile",
      "type": "object"
    },
    "ComponentIdentity": {
      "additionalProperties": false,
      "properties": {
        "built_from": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Built From",
          "type": "object"
        },
        "component": {
          "enum": [
            "DOCUMENT",
            "DATASET",
            "EVIDENCE",
            "DUCKDB",
            "NAV",
            "GRAPH",
            "SEARCH",
            "DENSE",
            "LATE",
            "VISUAL"
          ],
          "title": "Component",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "component",
        "revision",
        "manifest_sha256",
        "policy_sha256",
        "built_from"
      ],
      "title": "ComponentIdentity",
      "type": "object"
    },
    "LegacyFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 67108864,
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "file": {
          "$ref": "#/$defs/BoundFile"
        }
      },
      "required": [
        "file",
        "bytes"
      ],
      "title": "LegacyFile",
      "type": "object"
    },
    "RestoredLegacySelector": {
      "additionalProperties": false,
      "properties": {
        "restored": {
          "$ref": "#/$defs/BoundFile"
        },
        "source": {
          "$ref": "#/$defs/BoundFile"
        }
      },
      "required": [
        "source",
        "restored"
      ],
      "title": "RestoredLegacySelector",
      "type": "object"
    },
    "RetainedSharedObserver": {
      "additionalProperties": false,
      "description": "Read-only observation recipe, independent of candidate G/R/CURRENT.",
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentIdentity"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "duckdb": {
          "$ref": "#/$defs/BoundFile"
        },
        "environment": {
          "$ref": "#/$defs/BoundFile"
        },
        "max_local_identity_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 137438953472,
          "title": "Max Local Identity Bytes",
          "type": "integer"
        },
        "native": {
          "$ref": "#/$defs/BoundFile"
        },
        "nav": {
          "$ref": "#/$defs/BoundFile"
        },
        "runtime": {
          "$ref": "#/$defs/BoundFile"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceIdentity"
          },
          "minItems": 1,
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "environment",
        "runtime",
        "native",
        "duckdb",
        "nav",
        "max_local_identity_bytes",
        "components",
        "services"
      ],
      "title": "RetainedSharedObserver",
      "type": "object"
    },
    "ServiceIdentity": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "dependencies_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependencies Sha256",
          "type": "string"
        },
        "endpoint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Endpoint Sha256",
          "type": "string"
        },
        "instance_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Instance Sha256",
          "type": "string"
        },
        "resources": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "title": "Resources",
          "type": "object"
        },
        "runtime_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Sha256",
          "type": "string"
        },
        "service": {
          "enum": [
            "RETRIEVAL",
            "RERANK",
            "CONTROL"
          ],
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service",
        "instance_sha256",
        "code_sha256",
        "dependencies_sha256",
        "config_sha256",
        "endpoint_sha256",
        "runtime_sha256"
      ],
      "title": "ServiceIdentity",
      "type": "object"
    },
    "UnitPin": {
      "additionalProperties": false,
      "properties": {
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "image_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Id",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "config_sha256"
      ],
      "title": "UnitPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "backup_failure_domain": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
      "title": "Backup Failure Domain",
      "type": "string"
    },
    "independent_copy": {
      "$ref": "#/$defs/BoundFile"
    },
    "independent_restore": {
      "$ref": "#/$defs/BoundFile"
    },
    "max_control_bytes": {
      "default": 67108864,
      "exclusiveMinimum": 0,
      "maximum": 268435456,
      "title": "Max Control Bytes",
      "type": "integer"
    },
    "observer": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetainedSharedObserver"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "original_container_ids": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "api",
          "mcp",
          "mcp-admin"
        ]
      },
      "title": "Original Container Ids",
      "type": "object"
    },
    "owner_approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoundFile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "restore_compose": {
      "$ref": "#/$defs/BoundFile"
    },
    "restored_files": {
      "items": {
        "$ref": "#/$defs/LegacyFile"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Restored Files",
      "type": "array"
    },
    "schema_version": {
      "const": "vkm-first-live-legacy-boundary/1",
      "default": "vkm-first-live-legacy-boundary/1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": "SYNTHETIC",
      "enum": [
        "SYNTHETIC",
        "RECEIVER_CONTROL_ONLY"
      ],
      "title": "Scope",
      "type": "string"
    },
    "selector_restores": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RestoredLegacySelector"
      },
      "maxItems": 64,
      "title": "Selector Restores",
      "type": "array"
    },
    "selectors": {
      "items": {
        "$ref": "#/$defs/BoundFile"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Selectors",
      "type": "array"
    },
    "shared_services_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Shared Services Sha256",
      "type": "string"
    },
    "source_failure_domain": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
      "title": "Source Failure Domain",
      "type": "string"
    },
    "status": {
      "const": "UNQUALIFIED_LEGACY",
      "default": "UNQUALIFIED_LEGACY",
      "title": "Status",
      "type": "string"
    },
    "units": {
      "additionalProperties": {
        "$ref": "#/$defs/UnitPin"
      },
      "propertyNames": {
        "enum": [
          "api",
          "mcp",
          "mcp-admin"
        ]
      },
      "title": "Units",
      "type": "object"
    }
  },
  "required": [
    "restore_compose",
    "units",
    "original_container_ids",
    "selectors",
    "restored_files",
    "independent_copy",
    "independent_restore",
    "source_failure_domain",
    "backup_failure_domain",
    "shared_services_sha256"
  ],
  "title": "LegacyRecoveryBoundary",
  "type": "object"
}
