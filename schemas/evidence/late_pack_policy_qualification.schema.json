{
  "$defs": {
    "LoadedPackIdentity": {
      "additionalProperties": false,
      "properties": {
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "config_signature": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Signature",
          "type": "string"
        },
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Files",
          "type": "object"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "pack_id": {
          "minLength": 1,
          "title": "Pack Id",
          "type": "string"
        },
        "schema": {
          "const": "vkm-loaded-pack/1",
          "default": "vkm-loaded-pack/1",
          "title": "Schema",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "total_tokens": {
          "exclusiveMinimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "pack_id",
        "snapshot_id",
        "manifest_sha256",
        "config_signature",
        "config_sha256",
        "files",
        "count",
        "total_tokens"
      ],
      "title": "LoadedPackIdentity",
      "type": "object"
    },
    "PackPolicyBinding": {
      "additionalProperties": false,
      "properties": {
        "canonical_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Manifest Sha256",
          "type": "string"
        },
        "component_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Component Manifest Sha256",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "status": {
          "const": "PASS",
          "default": "PASS",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "component_manifest_sha256",
        "policy_sha256",
        "snapshot_id",
        "canonical_manifest_sha256"
      ],
      "title": "PackPolicyBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/PackPolicyBinding"
    },
    "binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Sha256",
      "type": "string"
    },
    "by_kind": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "By Kind",
      "type": "object"
    },
    "canonical_files_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Files Sha256",
      "type": "string"
    },
    "checks": {
      "additionalProperties": {
        "const": "PASS",
        "type": "string"
      },
      "title": "Checks",
      "type": "object"
    },
    "context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "context_variant": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "Context Variant",
      "type": "string"
    },
    "issuer": {
      "additionalProperties": true,
      "title": "Issuer",
      "type": "object"
    },
    "loaded_pack": {
      "$ref": "#/$defs/LoadedPackIdentity"
    },
    "model_quality": {
      "const": "NOT_RUN",
      "default": "NOT_RUN",
      "title": "Model Quality",
      "type": "string"
    },
    "schema": {
      "const": "vkm-late-policy-qualification/1",
      "default": "vkm-late-policy-qualification/1",
      "title": "Schema",
      "type": "string"
    },
    "scientific_qualification": {
      "const": "NOT_RUN",
      "default": "NOT_RUN",
      "title": "Scientific Qualification",
      "type": "string"
    },
    "scope": {
      "const": "CANONICAL_UNIT_POLICY_BINDING",
      "default": "CANONICAL_UNIT_POLICY_BINDING",
      "title": "Scope",
      "type": "string"
    },
    "selected_kinds": {
      "items": {
        "enum": [
          "BLOCK_GROUP",
          "FIGURE",
          "TABLE",
          "FORMULA",
          "BIB_ENTRY"
        ],
        "type": "string"
      },
      "title": "Selected Kinds",
      "type": "array"
    },
    "source_count": {
      "exclusiveMinimum": 0,
      "title": "Source Count",
      "type": "integer"
    },
    "status": {
      "const": "PASS",
      "default": "PASS",
      "title": "Status",
      "type": "string"
    },
    "unit_config": {
      "additionalProperties": true,
      "title": "Unit Config",
      "type": "object"
    },
    "unit_count": {
      "exclusiveMinimum": 0,
      "title": "Unit Count",
      "type": "integer"
    },
    "unit_rule": {
      "title": "Unit Rule",
      "type": "string"
    },
    "units_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Units Sha256",
      "type": "string"
    }
  },
  "required": [
    "binding",
    "binding_sha256",
    "loaded_pack",
    "context_sha256",
    "issuer",
    "unit_rule",
    "context_variant",
    "unit_config",
    "selected_kinds",
    "units_sha256",
    "unit_count",
    "by_kind",
    "source_count",
    "canonical_files_sha256",
    "checks"
  ],
  "title": "PackPolicyQualification",
  "type": "object"
}
