{
  "additionalProperties": false,
  "description": "Contents of an externally approved receipt, not a CLI-issued registration.\n\nAuthentication and append-only chronology belong to the operator's trusted\nregistry. This reader only verifies its externally supplied byte pin and the\nexact fields used by FrozenRegistration.",
  "properties": {
    "gold_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Gold Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "registered_at": {
      "format": "date-time",
      "title": "Registered At",
      "type": "string"
    },
    "registrar": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,199}$",
      "title": "Registrar",
      "type": "string"
    },
    "schema_version": {
      "const": "vkm-qualification-preregistration-receipt/1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "plan_sha256",
    "gold_sha256",
    "registered_at",
    "registrar"
  ],
  "title": "TrustedQualificationRegistration",
  "type": "object"
}
