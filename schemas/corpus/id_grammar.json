{
 "logical_roots": [
  "PRIVATE",
  "PUBLIC",
  "DATA",
  "WORK",
  "EDGE"
 ],
 "patterns": {
  "artifact": "^sha256:[0-9a-f]{64}$",
  "author": "^AUT-[0-9a-f]{12}$",
  "commit": "^CMT-[0-9a-f]{16}$",
  "commit_key": "^(?:VKM-SRC-[0-9]{3}|REGISTRY)$",
  "document": "^VKM-SRC-[0-9]{3}:doc$",
  "error": "^ERR-[0-9a-f]{16}$",
  "link": "^(?:SWL|WRL|SRL|WAU|BML|OLN)-[0-9a-f]{16}$",
  "object": "^VKM-SRC-[0-9]{3}:(?:[prs][0-9]{4}|doc):[bftmc][0-9a-f]{12}$",
  "page": "^VKM-SRC-[0-9]{3}:[prs][0-9]{4}$",
  "run": "^RUN-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
  "semver": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
  "sha256": "^[0-9a-f]{64}$",
  "snapshot": "^snap-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
  "source": "^VKM-SRC-[0-9]{3}$",
  "step": "^STP-[0-9a-f]{16}$",
  "venue": "^VEN-[0-9a-f]{12}$",
  "work": "^VKM-WRK-[0-9]{3}$"
 },
 "reserved": {
  "container_child_work": "^VKM-WRK-[0-9]{3}\\.[0-9]{2}$",
  "page_region": "^VKM-SRC-[0-9]{3}:[prs][0-9]{4}#bbox=[0-9.]+,[0-9.]+,[0-9.]+,[0-9.]+$",
  "source_4_digits": "^VKM-SRC-[0-9]{4}$",
  "text_span": "^VKM-SRC-[0-9]{3}:(?:[prs][0-9]{4}|doc):[bftmc][0-9a-f]{12}#chars=[0-9]+-[0-9]+@[0-9a-f]{12}$",
  "work_without_source": "^VKM-WRK-X[0-9]{5}$",
  "zip_member": "^VKM-SRC-[0-9]{3}/m[0-9]{3}$"
 }
}
