 "$id": "https://github.com/SUKUNA-AI/vkm-subsidence-forecasting/schemas/corpus/errors.schema.json",
 "additionalProperties": false,
 "description": "Error record (task §44): code, stage, tool, message, retryable, source, page, log reference.",
 "properties": {
  "attempt": {
   "anyOf": [
    {
     "maximum": 32767,
     "minimum": -32768,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Attempt"
  },
  "code": {
   "$ref": "#/$defs/ErrorCode"
  },
  "created_at": {
   "format": "date-time",
   "title": "Created At",
   "type": "string"
  },
  "error_id": {
   "pattern": "^ERR-[0-9a-f]{16}$",
   "title": "Error Id",
   "type": "string"
  },
  "exception_type": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Exception Type"
  },
  "log_ref": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Log Ref"
  },
  "message": {
   "description": "sanitised: no absolute paths",
   "title": "Message",
   "type": "string"
  },
  "page_id": {
   "anyOf": [
    {
     "pattern": "^VKM-SRC-[0-9]{3}:[prs][0-9]{4}$",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Page Id"
  },
  "page_index": {
   "anyOf": [
    {
     "maximum": 2147483647,
     "minimum": -2147483648,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "set when pagination failed and no page_id exists",
   "title": "Page Index"
  },
  "processing_run_id": {
   "pattern": "^RUN-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$",
   "title": "Processing Run Id",
   "type": "string"
  },
  "retryable": {
   "title": "Retryable",
   "type": "boolean"
  },
  "schema_version": {
   "description": "semver of the dataset schema at write time",
   "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
   "title": "Schema Version",
   "type": "string"
  },
  "severity": {
   "$ref": "#/$defs/Severity",
   "default": "ERROR"
  },
  "source_id": {
   "anyOf": [
    {
     "pattern": "^VKM-SRC-[0-9]{3}$",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Source Id"
  },
  "stage": {
   "$ref": "#/$defs/Stage"
  },
  "step_id": {
   "anyOf": [
    {
     "pattern": "^STP-[0-9a-f]{16}$",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Step Id"
  },
  "tool": {
   "title": "Tool",
   "type": "string"
  },
  "tool_version": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Tool Version"
  }
 },
 "required": [
  "schema_version",
  "error_id",
  "processing_run_id",
  "stage",
  "code",
  "tool",
  "message",
  "retryable",
  "created_at"
 ],
 "title": "VKM corpus dataset errors",
 "type": "object",
 "x-vkm-dataset": "errors",
 "x-vkm-dataset-class": "APPEND_LOG",
 "x-vkm-envelope-profile": "LOG",
 "x-vkm-primary-key": [
  "error_id"
 ],
 "x-vkm-schema-fingerprint": "dac594dcd6bd3484a4a1399a101d8a604749a3a664503999ab5aba3e0c9ef7bd",
 "x-vkm-schema-version": "0.1.0"
}
