! S04 gravity and loads: SOLID185 column A_SIDE x A_SIDE x H_COL with density RHO under gravity G (ACEL along +Z
! gives a load along -Z). Supports: UZ = 0 at z = 0, rollers on all four lateral faces (UX = 0 on x = 0 and A_SIDE,
! UY = 0 on y = 0 and A_SIDE): uniaxial strain. Closed form with M = E(1-nu)/((1+nu)(1-2nu)):
! SZ(z) = -RHO*G*(H_COL - z), SX = SY = nu/(1-nu)*SZ, uz(z) = -(RHO*G/M)*(H_COL*z - z**2/2).
/TITLE,VKM ladder S04 - gravity (uniaxial strain column)
/PREP7
ET,1,SOLID185
MP,EX,1,E_MOD
MP,PRXY,1,NU
MP,DENS,1,RHO
BLOCK,0,A_SIDE,0,A_SIDE,0,H_COL
LSEL,S,LOC,Z,H_COL/2
LESIZE,ALL,,,N_Z
LSEL,INVE
LESIZE,ALL,,,N_XY
LSEL,ALL
MSHAPE,0,3D
MSHKEY,1
VMESH,ALL
FINISH
/SOLU
ANTYPE,STATIC
NSEL,S,LOC,Z,0
D,ALL,UZ,0
NSEL,S,LOC,X,0
NSEL,A,LOC,X,A_SIDE
D,ALL,UX,0
NSEL,S,LOC,Y,0
NSEL,A,LOC,Y,A_SIDE
D,ALL,UY,0
ALLSEL,ALL
ACEL,0,0,G
OUTRES,ALL,ALL
SOLVE
FINISH
/POST1
SET,LAST
NSEL,S,LOC,Z,H_COL
NSORT,U,Z
*GET,UZT_MIN,SORT,0,MIN
*GET,UZT_MAX,SORT,0,MAX
NUSORT
ALLSEL,ALL
*GET,N_NODE,NODE,0,COUNT
*GET,N_ELEM,ELEM,0,COUNT
*CFOPEN,vkm_results,txt
*VWRITE,UZT_MIN
('uz_top_min = ',E24.16)
*VWRITE,UZT_MAX
('uz_top_max = ',E24.16)
*VWRITE,N_NODE
('n_node = ',E24.16)
*VWRITE,N_ELEM
('n_elem = ',E24.16)
*CFCLOSE
! element table: centroid z and element stresses (ETABLE = mean of the element nodal values)
ETABLE,ESX,S,X
ETABLE,ESY,S,Y
ETABLE,ESZ,S,Z
*GET,EMAXD,ELEM,0,NUM,MAXD
*DIM,VE_ID,ARRAY,EMAXD
*DIM,VE_Z,ARRAY,EMAXD
*DIM,VE_SX,ARRAY,EMAXD
*DIM,VE_SY,ARRAY,EMAXD
*DIM,VE_SZ,ARRAY,EMAXD
*VFILL,VE_ID(1),RAMP,1,1
*VGET,VE_Z(1),ELEM,1,CENT,Z
*VGET,VE_SX(1),ELEM,1,ETAB,ESX
*VGET,VE_SY(1),ELEM,1,ETAB,ESY
*VGET,VE_SZ(1),ELEM,1,ETAB,ESZ
*CFOPEN,vkm_elems_zs,txt
*VWRITE,VE_ID(1),VE_Z(1),VE_SX(1),VE_SZ(1)
(F10.0,3E24.16)
*CFCLOSE
*CFOPEN,vkm_elems_sy,txt
*VWRITE,VE_ID(1),VE_SY(1)
(F10.0,E24.16)
*CFCLOSE
! node tables for S08
*GET,NMAXD,NODE,0,NUM,MAXD
*DIM,VK_ID,ARRAY,NMAXD
*DIM,VK_X,ARRAY,NMAXD
*DIM,VK_Y,ARRAY,NMAXD
*DIM,VK_Z,ARRAY,NMAXD
*DIM,VK_UX,ARRAY,NMAXD
*DIM,VK_UY,ARRAY,NMAXD
*DIM,VK_UZ,ARRAY,NMAXD
*VFILL,VK_ID(1),RAMP,1,1
*VGET,VK_X(1),NODE,1,LOC,X
*VGET,VK_Y(1),NODE,1,LOC,Y
*VGET,VK_Z(1),NODE,1,LOC,Z
*VGET,VK_UX(1),NODE,1,U,X
*VGET,VK_UY(1),NODE,1,U,Y
*VGET,VK_UZ(1),NODE,1,U,Z
*CFOPEN,vkm_nodes_xyz,txt
*VWRITE,VK_ID(1),VK_X(1),VK_Y(1),VK_Z(1)
(F10.0,3E24.16)
*CFCLOSE
*CFOPEN,vkm_nodes_u,txt
*VWRITE,VK_ID(1),VK_UX(1),VK_UY(1),VK_UZ(1)
(F10.0,3E24.16)
*CFCLOSE
/OUTPUT,vkm_prnsol_u,txt
PRNSOL,U,COMP
/OUTPUT
FINISH
