! S07 rheology: implicit creep, Norton law TB,CREEP TBOPT = 10: d(eps_cr)/dt = C1*sigma**C2*exp(-C3/T) with C3 = 0
! (no temperature term; TOFFST keeps T > 0). The S02 column (uniaxial stress, free lateral expansion) under constant
! pressure P_TOP: LS1 elastic (RATE,OFF, TIME = T_EL), LS2 creep (RATE,ON) to T_END in NSUB equal substeps.
! Closed form: EPCR_Z(t) = -C1*P_TOP**C2*(t - T_EL), EPCR_X = EPCR_Y = -EPCR_Z/2,
! uz(top, t) = -P_TOP*L_COL/E_MOD + EPCR_Z(t)*L_COL.
/TITLE,VKM ladder S07 - Norton creep under constant stress
/PREP7
ET,1,SOLID185
MP,EX,1,E_MOD
MP,PRXY,1,NU
TB,CREEP,1,,,10
TBDATA,1,C1,C2,0
TOFFST,273.15
TREF,20
BLOCK,0,A_SIDE,0,A_SIDE,0,L_COL
LSEL,S,LOC,Z,L_COL/2
LESIZE,ALL,,,N_Z
LSEL,INVE
LESIZE,ALL,,,N_XY
LSEL,ALL
MSHAPE,0,3D
MSHKEY,1
VMESH,ALL
FINISH
/SOLU
ANTYPE,STATIC
BFUNIF,TEMP,20
NSEL,S,LOC,Z,0
D,ALL,UZ,0
NSEL,S,LOC,X,0
D,ALL,UX,0
NSEL,S,LOC,Y,0
D,ALL,UY,0
NSEL,S,LOC,Z,L_COL
SF,ALL,PRES,P_TOP
ALLSEL,ALL
OUTRES,ALL,ALL
KBC,1
RATE,OFF
TIME,T_EL
NSUBST,1,1,1
SOLVE
RATE,ON
AUTOTS,OFF
TIME,T_END
NSUBST,NSUB,NSUB,NSUB
SOLVE
FINISH
/POST1
*GET,N_SET,ACTIVE,0,SET,NSET
*CFOPEN,vkm_results,txt
*VWRITE,N_SET
('n_set = ',E24.16)
*CFCLOSE
ETABLE,ECZ,EPCR,Z
ETABLE,ECX,EPCR,X
*CFOPEN,vkm_history,txt
*DO,IS,1,N_SET
SET,,,,,,,IS
*GET,T_S,ACTIVE,0,SET,TIME
ETABLE,REFL
ESORT,ETAB,ECZ
*GET,ECZ_MIN,SORT,0,MIN
*GET,ECZ_MAX,SORT,0,MAX
ESORT,ETAB,ECX
*GET,ECX_MIN,SORT,0,MIN
EUSORT
NSEL,S,LOC,Z,L_COL
NSORT,U,Z
*GET,U_MIN,SORT,0,MIN
*GET,U_MAX,SORT,0,MAX
NUSORT
ALLSEL,ALL
*VWRITE,IS,1,T_S,ECZ_MIN,ECZ_MAX
(F8.0,F4.0,3E24.16)
*VWRITE,IS,2,ECX_MIN,U_MIN,U_MAX
(F8.0,F4.0,3E24.16)
*ENDDO
*CFCLOSE
FINISH
