! S06 time steps: the S02 column loaded in two ramped load steps (KBC,0) tracked by TIME:
! LS1 TIME 0 -> T1, pressure 0 -> P1 in NS1 substeps; LS2 TIME T1 -> T2, pressure P1 -> P2 in NS2 substeps.
! Every substep is stored (OUTRES,ALL,ALL). Closed form: p(t) linear in each step, uz(top, t) = -p(t)*L_COL/E_MOD.
/TITLE,VKM ladder S06 - load steps and substeps with TIME
/PREP7
ET,1,SOLID185
MP,EX,1,E_MOD
MP,PRXY,1,NU
BLOCK,0,A_SIDE,0,A_SIDE,0,L_COL
LSEL,S,LOC,Z,L_COL/2
LESIZE,ALL,,,N_Z
LSEL,INVE
LESIZE,ALL,,,N_XY
LSEL,ALL
MSHAPE,0,3D
MSHKEY,1
VMESH,ALL
FINISH
/SOLU
ANTYPE,STATIC
NSEL,S,LOC,Z,0
D,ALL,UZ,0
NSEL,S,LOC,X,0
D,ALL,UX,0
NSEL,S,LOC,Y,0
D,ALL,UY,0
ALLSEL,ALL
OUTRES,ALL,ALL
AUTOTS,OFF
KBC,0
NSEL,S,LOC,Z,L_COL
SF,ALL,PRES,P1
ALLSEL,ALL
TIME,T1
NSUBST,NS1
SOLVE
NSEL,S,LOC,Z,L_COL
SF,ALL,PRES,P2
ALLSEL,ALL
TIME,T2
NSUBST,NS2
SOLVE
FINISH
/POST1
*GET,N_SET,ACTIVE,0,SET,NSET
*CFOPEN,vkm_results,txt
*VWRITE,N_SET
('n_set = ',E24.16)
*CFCLOSE
*CFOPEN,vkm_history,txt
*DO,IS,1,N_SET
SET,,,,,,,IS
*GET,T_S,ACTIVE,0,SET,TIME
*GET,LS_S,ACTIVE,0,SET,LSTP
*GET,SB_S,ACTIVE,0,SET,SBST
NSEL,S,LOC,Z,L_COL
NSORT,U,Z
*GET,U_MIN,SORT,0,MIN
*GET,U_MAX,SORT,0,MAX
NUSORT
ALLSEL,ALL
*VWRITE,IS,LS_S,SB_S,T_S,U_MIN,U_MAX
(3F8.0,3E24.16)
*ENDDO
*CFCLOSE
FINISH
