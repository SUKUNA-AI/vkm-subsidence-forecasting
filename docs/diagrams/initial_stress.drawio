        </mxCell>
        <mxCell id="h1" value="IS-H-01 гидростатическая (Гейм): σx = σy = σz = γH, λ = 1 — MODEL_CHOICE; кандидат IS-SC-A" style="align=left;fillColor=#ffe6cc;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;whiteSpace=wrap;" vertex="1" parent="1">
