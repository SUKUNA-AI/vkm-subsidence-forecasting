        <mxCell id="h2" value="IS-H-02 релаксация девиатора в соли: σгор → σверт при t → ∞ — механизм правдоподобен, время UNKNOWN" style="align=left;fillColor=#ffe6cc;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="187" width="540" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="IS-H-03 упругое боковое ограничение (Динник): λ = ν/(1 − ν) — в соли противоречит данным; для надсолевой толщи — сценарий IS-SC-C" style="align=left;fillColor=#ffe6cc;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;whiteSpace=wrap;" vertex="1" parent="1">
