          <mxGeometry x="700" y="90" width="300" height="700" as="geometry" />
        </mxCell>
        <mxCell id="ph4" value="4 commit — subprocess на источник, CPU" style="swimlane;collapsible=0;container=1;fillColor=#fff2cc;fontSize=13;fontStyle=1;html=1;rounded=0;startSize=28;strokeColor=#d6b656;swimlaneFillColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1020" y="90" width="300" height="700" as="geometry" />
