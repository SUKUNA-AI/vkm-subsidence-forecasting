        <mxCell id="render" value="рендер 200 dpi (не хранится — воспроизводится по рецепту), превью JPEG 1024 px, доля «чернил»" style="fillColor=#fff2cc;fontSize=13;html=1;rounded=1;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="ph2">
          <mxGeometry x="15" y="45" width="270" height="75" as="geometry" />
        </mxCell>
        <mxCell id="layout" value="PP-DocLayoutV3 (transformers, GPU, fp32, офлайн): ≈ 70 мс на страницу" style="fillColor=#fff2cc;fontSize=13;html=1;rounded=1;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="ph2">
          <mxGeometry x="15" y="145" width="270" height="65" as="geometry" />
        </mxCell>
        <mxCell id="layraw" value="LAYOUT_RAW (KEEP_RAW): пары «запрос × класс» top-300, score ≥ 0.05, рамки и порядок чтения" style="boundedLbl=1;fillColor=#dae8fc;fontSize=13;html=1;shape=document;strokeColor=#6c8ebf;whiteSpace=wrap;" vertex="1" parent="ph2">
