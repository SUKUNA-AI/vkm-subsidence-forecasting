        </mxCell>
        <mxCell id="ph2" value="2 visual — один subprocess с GPU" style="swimlane;collapsible=0;container=1;fillColor=#fff2cc;fontSize=13;fontStyle=1;html=1;rounded=0;startSize=28;strokeColor=#d6b656;swimlaneFillColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1">
