        <mxCell id="crops" value="кропы регионов без пригодного текста, формул и таблиц: формулы 300 dpi, текст и таблицы 200 dpi; высокие регионы — полосы" style="fillColor=#fff2cc;fontSize=13;html=1;rounded=1;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="ph3">
