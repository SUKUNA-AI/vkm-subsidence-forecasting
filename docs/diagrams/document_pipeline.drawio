          <mxGeometry x="15" y="115" width="310" height="45" as="geometry" />
        </mxCell>
        <mxCell id="pages" value="страницы двумя методами:&lt;br&gt;PDF — PyMuPDF / pypdfium2&lt;br&gt;DjVu — djvused / обход IFF&lt;br&gt;EPUB — spine lxml / stdlib&lt;br&gt;DOCX — закреплённый рендер LibreOffice&lt;br&gt;расхождение → NEEDS_REVIEW, PAGECOUNT_MISMATCH" style="align=left;fillColor=#fff2cc;fontSize=13;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="ph1">
