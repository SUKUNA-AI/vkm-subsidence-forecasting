  <diagram id="pipeline" name="Путь документа">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1030" math="0" shadow="0" background="#ffffff">
      <root>
