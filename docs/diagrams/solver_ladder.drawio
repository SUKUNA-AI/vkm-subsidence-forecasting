          <mxGeometry x="20" y="186" width="380" height="46" as="geometry" />
        </mxCell>
        <mxCell id="st3" value="3. зоны материалов" style="align=left;fillColor=#fff2cc;fontSize=13;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="244" width="380" height="46" as="geometry" />
        </mxCell>
        <mxCell id="st4" value="4. гравитация и нагрузки" style="align=left;fillColor=#fff2cc;fontSize=13;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="302" width="380" height="46" as="geometry" />
        </mxCell>
