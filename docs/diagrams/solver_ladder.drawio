<mxfile host="vkm-drawio" agent="vkm-drawio writer/1" compressed="false" pages="1">
  <diagram id="solvers" name="Лестница решателя">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="930" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Лестница решателя и роли инженерных программ (D-19; состояние 29.09.2026)" style="text;align=left;fontSize=20;fontStyle=1;html=1;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="1760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Любой решатель запускается только по явной задаче Phase 2 и по лестнице из CLAUDE.md. Результат решателя — модельный: не наблюдение и не полевая валидация." style="text;align=left;fontColor=#444444;fontSize=12;html=1;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="44" width="1760" height="25" as="geometry" />
        </mxCell>
        <mxCell id="l_head" value="Лестница (CLAUDE.md)" style="text;align=left;fontSize=14;fontStyle=1;html=1;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="95" width="380" height="26" as="geometry" />
        </mxCell>
        <mxCell id="st1" value="1. установка и версия" style="align=left;fillColor=#fff2cc;fontSize=13;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="128" width="380" height="46" as="geometry" />
        </mxCell>
