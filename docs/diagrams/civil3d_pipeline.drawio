        </mxCell>
        <mxCell id="lg_tx_derived" value="производные объекты (INTERPOLATION / DERIVATION)" style="text;align=left;fontSize=12;html=1;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="legend">
