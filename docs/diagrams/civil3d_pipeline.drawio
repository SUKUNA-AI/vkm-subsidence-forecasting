        <mxCell id="sources" value="Источники: docs/corpus_platform/MCP_TOOLS.md §4.1; implementation_work/AGENT_CAD_V1.md §1–§4, §7; receipts/cad_v1_smoke.json; implementation_work/COORDINATOR_DECISIONS.md (CP-43); README.md §10; docs/planning/PHASE2_PLAN_OCT_NOV_2026_RU.md §1, §3." style="text;align=left;fontColor=#555555;fontSize=11;html=1;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
