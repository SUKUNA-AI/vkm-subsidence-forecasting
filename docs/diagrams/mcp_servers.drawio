        <mxCell id="adm_flow" value="plan-first: PLAN_REQUESTED → PLANNED (воркер публикует план и plan_sha256) → CONFIRMED (человек подтверждает этот хеш) → RUNNING → PUBLISHED → ADMITTED | REJECTED" style="fillColor=#fff2cc;fontSize=12;html=1;rounded=1;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="admin">
