        <mxCell id="g_dossier" value="Досье (1)&lt;br&gt;reconstruct_topic — карта темы «от А до Я»" style="align=left;fillColor=#fff2cc;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="corpus">
          <mxGeometry x="750" y="200" width="235" height="95" as="geometry" />
