        </mxCell>
        <mxCell id="g_obj" value="Объекты и провенанс (15)&lt;br&gt;get_source, get_work, get_page, get_page_image, get_figure, get_table, get_formula, get_object, get_document_neighbors, get_citations, list_source_pages, get_artifact, trace_document_provenance, get_processing_status, get_corpus_status" style="align=left;fillColor=#fff2cc;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="corpus">
          <mxGeometry x="15" y="145" width="480" height="150" as="geometry" />
        </mxCell>
