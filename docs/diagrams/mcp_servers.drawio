        <mxCell id="api" value="VKM API /v1 (канон DuckDB, OpenSearch, Neo4j, NavStore, пакет каталогов, rx580-retrieval; реранк — шлюз EDGE)" style="fillColor=#dae8fc;fontSize=12;html=1;rounded=1;strokeColor=#6c8ebf;whiteSpace=wrap;" vertex="1" parent="corpus">
          <mxGeometry x="15" y="320" width="970" height="55" as="geometry" />
        </mxCell>
        <mxCell id="rule_c" value="Правила: канон API и MCP не пишут никогда; результаты поиска — кандидаты из проекций (сниппет индекса — не текст объекта); автоматическое содержимое — AUTO_EXTRACTED_UNREVIEWED, не факт; область источника наследуется объектами, но не устанавливается для них." style="align=left;fillColor=#ffffff;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#666666;whiteSpace=wrap;" vertex="1" parent="corpus">
          <mxGeometry x="15" y="395" width="970" height="70" as="geometry" />
        </mxCell>
        <mxCell id="limits" value="Лимиты: rerank_text ≤ 24 кандидата, rerank_visual ≤ 8 изображений; изображения — длинная сторона 1024 px по умолчанию; досье — budget_chars ≤ 60 000." style="align=left;fillColor=#ffffff;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#666666;whiteSpace=wrap;" vertex="1" parent="corpus">
          <mxGeometry x="15" y="480" width="970" height="55" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="vkm-corpus-admin — CORE, HTTP + отдельный токен" style="align=left;collapsible=0;container=1;dashed=0;fillColor=none;fontSize=12;fontStyle=1;html=1;rounded=0;spacingLeft=8;spacingTop=2;strokeColor=#999999;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1310" y="90" width="450" height="300" as="geometry" />
        </mxCell>
        <mxCell id="adm_tools" value="reprocess_source, reprocess_page (write, идемпотентные); get_job (read); cancel_job (destructive, только до запуска)" style="fillColor=#fff2cc;fontSize=12;html=1;rounded=1;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="admin">
          <mxGeometry x="15" y="35" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="adm_flow" value="plan-first: PLAN_REQUESTED → PLANNED (воркер публикует план и plan_sha256) → CONFIRMED (человек подтверждает этот хеш) → RUNNING → PUBLISHED → ADMITTED | REJECTED" style="fillColor=#fff2cc;fontSize=12;html=1;rounded=1;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="admin">
          <mxGeometry x="15" y="130" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="adm_rule" value="подключается только осознанно; ≤ 20 заданий на страницы и ≤ 3 на источники" style="fillColor=#ffffff;fontSize=12;html=1;rounded=1;strokeColor=#666666;whiteSpace=wrap;" vertex="1" parent="admin">
          <mxGeometry x="15" y="245" width="420" height="45" as="geometry" />
        </mxCell>
