        <mxCell id="g_search" value="Поиск (6)&lt;br&gt;search_text, search_hybrid, search_objects, retrieval_trace, rerank_text, rerank_visual" style="align=left;fillColor=#fff2cc;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="corpus">
