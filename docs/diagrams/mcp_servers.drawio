        <mxCell id="title" value="MCP-серверы проекта и группы инструментов (состояние 29.09.2026)" style="text;align=left;fontSize=20;fontStyle=1;html=1;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="1740" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Подключение — локальный неотслеживаемый .mcp.json; адреса и токены — только переменные окружения. Ответы корпуса — в конверте vkm.envelope/1 (ID, источник и страница, review_status, origin, провенанс)." style="text;align=left;fontColor=#444444;fontSize=12;html=1;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="44" width="1740" height="25" as="geometry" />
        </mxCell>
        <mxCell id="claude" value="Claude Code&lt;br&gt;(MCP-клиент на WORKSTATION)" style="fillColor=#e1d5e7;fontSize=13;html=1;rounded=1;strokeColor=#9673a6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="corpus" value="vkm-corpus — CORE, streamable HTTP + токен; 38 инструментов чтения (read_only_hint)" style="align=left;collapsible=0;container=1;dashed=0;fillColor=none;fontSize=12;fontStyle=1;html=1;rounded=0;spacingLeft=8;spacingTop=2;strokeColor=#999999;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
