        <mxCell id="sources" value="Источники: README.md §11; benchmarks/retrieval_v0/MODEL_SELECTION_V0.md; benchmarks/retrieval_v1/RESULTS_V1.md §0–§1; benchmarks/retrieval_v2/RESULTS_V2.md; benchmarks/topic_v1/RESULTS_V1.md §0–§2, RESULTS_POOL_T2.md, RESULTS_POOL_T3.md; receipts/retrieval_v1_h_review.json; COORDINATOR_DECISIONS.md (CP-39)." style="text;align=left;fontColor=#555555;fontSize=11;html=1;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="620" width="1100" height="40" as="geometry" />
