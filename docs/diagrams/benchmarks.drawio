        <mxCell id="lg_sw_derived" value="" style="fillColor=#dae8fc;html=1;rounded=0;strokeColor=#6c8ebf;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="10" y="59" width="34" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg_tx_derived" value="измеренные результаты (сигнал поиска, не evidence)" style="text;align=left;fontSize=12;html=1;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="52" y="57" width="570" height="25" as="geometry" />
