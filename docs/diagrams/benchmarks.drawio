        <mxCell id="lg_sw_evidence" value="" style="fillColor=#d5e8d4;html=1;rounded=0;strokeColor=#82b366;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="10" y="88" width="34" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg_tx_evidence" value="решение или итог" style="text;align=left;fontSize=12;html=1;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="52" y="86" width="570" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lg_sw_paused" value="" style="dashed=1;fillColor=#f5f5f5;fontColor=#333333;html=1;rounded=0;strokeColor=#666666;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="10" y="117" width="34" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg_tx_paused" value="следующий, ещё не предрегистрирован" style="text;align=left;fontSize=12;html=1;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="52" y="115" width="570" height="25" as="geometry" />
