        <mxCell id="lg_tx_service" value="бенчмарк" style="text;align=left;fontSize=12;html=1;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="52" y="28" width="570" height="25" as="geometry" />
