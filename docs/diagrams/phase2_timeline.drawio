        <mxCell id="p5_w" value="Текст диплома, графическая часть (Civil 3D), проверка, презентация" style="align=left;fillColor=#ffffff;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;spacingTop=4;strokeColor=#666666;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
