        <mxCell id="p3_d" value="20.10–02.11" style="fillColor=#fff2cc;fontSize=12;fontStyle=1;html=1;rounded=1;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="688.5" y="164" width="351" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p3_w" value="Ансамбль: World-0 — тысячи миров, Ansys — сотни, OGS — 2–3 сценария; внешняя эквивалентность и модель ошибки представления; покрытие ансамбля и NROY по реальным наблюдениям корпуса" style="align=left;fillColor=#ffe6cc;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;spacingTop=4;strokeColor=#d79b00;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="688.5" y="206" width="351" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p3_g" value="ансамбль с квитанциями; сверка решателей; отчёт покрытия; NROY" style="align=left;fillColor=#d5e8d4;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#82b366;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="688.5" y="416" width="351" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4_d" value="03.11–16.11" style="fillColor=#fff2cc;fontSize=12;fontStyle=1;html=1;rounded=1;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1045.5" y="164" width="351" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p4_w" value="Методы прогноза, включая нейросеть; предрегистрированный бенчмарк; отложенные семейства и решатель; различимость; оценка на отложенных мирах и отдельно на реальных наблюдениях корпуса" style="align=left;fillColor=#ffe6cc;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;spacingTop=4;strokeColor=#d79b00;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1045.5" y="206" width="351" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p4_g" value="отчёт бенчмарка; ограничения применимости" style="align=left;fillColor=#d5e8d4;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#82b366;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1045.5" y="416" width="351" height="80" as="geometry" />
