        <mxCell id="p1_w" value="Закрыть платформу (навигационный слой, V1). Модель данных L4: миры, представления, наблюдения, прогоны. Таблицы законов и наборов параметров с основаниями из корпуса (NAV, MCP). Семейства миров" style="align=left;fillColor=#ffe6cc;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;spacingTop=4;strokeColor=#d79b00;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="153" y="206" width="172.5" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p1_g" value="утверждённые проект ядер, семейства и оси; таблицы параметров (факт или сценарий)" style="align=left;fillColor=#d5e8d4;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#82b366;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="153" y="416" width="172.5" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_d" value="06.10–19.10" style="fillColor=#fff2cc;fontSize=12;fontStyle=1;html=1;rounded=1;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="331.5" y="164" width="351" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p2_w" value="Достраивание C1…C5; ObservationWorld; Ansys (PyMAPDL): лестница решателя и эталонные задачи; World-0 v0 — порты, K из Ansys, законы; первые миры" style="align=left;fillColor=#ffe6cc;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;spacingTop=4;strokeColor=#d79b00;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="331.5" y="206" width="351" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2_g" value="миры проходят проверки; Ansys на эталонной задаче" style="align=left;fillColor=#d5e8d4;fontSize=12;html=1;rounded=1;spacingLeft=6;spacingRight=4;strokeColor=#82b366;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="331.5" y="416" width="351" height="80" as="geometry" />
