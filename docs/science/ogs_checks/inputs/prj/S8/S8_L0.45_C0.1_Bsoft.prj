<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProject>
    <mesh>toy_rooms.vtu</mesh>
    <geometry>toy.gml</geometry>
    <search_length_algorithm><type>fixed</type><value>1e-6</value>
</search_length_algorithm>
    
    <processes>
        <process>
            <name>SD</name>
            <type>SMALL_DEFORMATION</type>
            <integration_order>3</integration_order>
            <constitutive_relation id="0"><type>LinearElasticIsotropic</type>
<youngs_modulus>E_marl</youngs_modulus>
<poissons_ratio>nu_marl</poissons_ratio>
</constitutive_relation>
<constitutive_relation id="1"><type>CreepBGRa</type>
<youngs_modulus>E_rock_salt</youngs_modulus>
<poissons_ratio>nu_rock_salt</poissons_ratio>
<a>A_rock_salt</a>
<n>n_rock_salt</n>
<sigma0>s0</sigma0>
<q>Q</q>
<nonlinear_solver>
<maximum_iterations>200</maximum_iterations>
<residuum_tolerance>1e-6</residuum_tolerance>
<increment_tolerance>1e-9</increment_tolerance>
</nonlinear_solver>
</constitutive_relation>
<constitutive_relation id="2"><type>CreepBGRa</type>
<youngs_modulus>E_rock_salt</youngs_modulus>
<poissons_ratio>nu_rock_salt</poissons_ratio>
<a>A_rock_salt</a>
<n>n_rock_salt</n>
<sigma0>s0</sigma0>
<q>Q</q>
<nonlinear_solver>
<maximum_iterations>200</maximum_iterations>
<residuum_tolerance>1e-6</residuum_tolerance>
<increment_tolerance>1e-9</increment_tolerance>
</nonlinear_solver>
</constitutive_relation>
<constitutive_relation id="5"><type>CreepBGRa</type>
<youngs_modulus>E_rock_salt</youngs_modulus>
<poissons_ratio>nu_rock_salt</poissons_ratio>
<a>A_rock_salt</a>
<n>n_rock_salt</n>
<sigma0>s0</sigma0>
<q>Q</q>
<nonlinear_solver>
<maximum_iterations>200</maximum_iterations>
<residuum_tolerance>1e-6</residuum_tolerance>
<increment_tolerance>1e-9</increment_tolerance>
</nonlinear_solver>
</constitutive_relation>
<constitutive_relation id="3"><type>CreepBGRa</type>
<youngs_modulus>E_sylvinite</youngs_modulus>
<poissons_ratio>nu_sylvinite</poissons_ratio>
<a>A_sylvinite</a>
<n>n_sylvinite</n>
<sigma0>s0</sigma0>
<q>Q</q>
<nonlinear_solver>
<maximum_iterations>200</maximum_iterations>
<residuum_tolerance>1e-6</residuum_tolerance>
<increment_tolerance>1e-9</increment_tolerance>
</nonlinear_solver>
</constitutive_relation>
<constitutive_relation id="4"><type>LinearElasticIsotropic</type>
<youngs_modulus>E_room</youngs_modulus>
<poissons_ratio>nu_room</poissons_ratio>
</constitutive_relation>
            <specific_body_force>0.0 -9.81</specific_body_force>
            <initial_stress>sigma0</initial_stress>
            <reference_temperature>T_ref</reference_temperature>
            
            <process_variables>
<process_variable>displacement</process_variable>
</process_variables>
            <secondary_variables>
<secondary_variable name="sigma"/>
<secondary_variable name="epsilon"/>
</secondary_variables>
        </process>
    </processes>
    <time_loop>
        <processes>
            <process ref="SD">
                <nonlinear_solver>basic_newton</nonlinear_solver>
                <convergence_criterion><type>DeltaX</type>
<norm_type>NORM2</norm_type>
<abstol>1e-07</abstol>
<reltol>1e-09</reltol>
</convergence_criterion>
                <time_discretization><type>BackwardEuler</type>
</time_discretization>
                <time_stepping><type>IterationNumberBasedTimeStepping</type>
<t_initial>0.0</t_initial>
<t_end>1577880000.0</t_end>
<initial_dt>1.0</initial_dt>
<minimum_dt>0.001</minimum_dt>
<maximum_dt>15778800.0</maximum_dt>
<number_iterations>2 4 6 10 15</number_iterations>
<multiplier>5.0 2.0 1.2 0.8 0.5</multiplier>
</time_stepping>
            </process>
        </processes>
        <output><type>VTK</type>
<prefix>L0.45_C0.1_Bsoft</prefix>
<data_mode>Ascii</data_mode>
<compress_output>false</compress_output>
<fixed_output_times>1.0 31557600.0 63115200.0 157788000.0 315576000.0 347133600.0 473364000.0 631152000.0 946728000.0 1262304000.0 1577880000.0</fixed_output_times>
<variables>
<variable>displacement</variable>
<variable>sigma</variable>
</variables>
<suffix>_ts_{:timestep}_t_{:time}</suffix>
</output>
    </time_loop>
