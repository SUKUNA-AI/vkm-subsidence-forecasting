    <parameters>
        <parameter><name>zero</name><type>Constant</type><value>0.0</value>
</parameter>
<parameter><name>u0</name><type>Constant</type><values>0.0 0.0</values>
</parameter>
<parameter><name>s0</name><type>Constant</type><value>1000000.0</value>
</parameter>
<parameter><name>Q</name><type>Constant</type><value>0.0</value>
</parameter>
<parameter><name>T_ref</name><type>Constant</type><value>293.15</value>
</parameter>
<parameter><name>E_marl</name><type>Constant</type><value>600000000.0</value>
</parameter>
<parameter><name>nu_marl</name><type>Constant</type><value>0.3</value>
</parameter>
<parameter><name>E_rock_salt</name><type>Constant</type><value>9500000000.0</value>
</parameter>
<parameter><name>nu_rock_salt</name><type>Constant</type><value>0.3</value>
</parameter>
<parameter><name>E_sylvinite</name><type>Constant</type><value>10800000000.0</value>
</parameter>
<parameter><name>nu_sylvinite</name><type>Constant</type><value>0.2</value>
</parameter>
<parameter><name>A_rock_salt</name><type>Constant</type><value>1.5277777777777777e-19</value>
</parameter>
<parameter><name>n_rock_salt</name><type>Constant</type><value>6.5</value>
</parameter>
<parameter><name>A_sylvinite</name><type>Constant</type><value>2.4537037037037038e-19</value>
</parameter>
<parameter><name>n_sylvinite</name><type>Constant</type><value>6.5</value>
</parameter>
<parameter><name>sigma0</name><type>Function</type><expression>if((y &lt; -294.0) and (y &gt; -299.5) and (x &lt; 170.0) and (abs(x - 27.0*round(x/27.0)) &lt; 8.0), 0.0, 0.45*(if(y &gt; -185.9, (0.0 + 22000.0*(y - (0.0))), if(y &gt; -194.4, (-4089800.0 + 22000.0*(y - (-185.9))), if(y &gt; -205.4, (-4276800.0 + 22000.0*(y - (-194.4))), if(y &gt; -287.4, (-4518800.0 + 22000.0*(y - (-205.4))), if(y &gt; -294.0, (-6322799.999999999 + 21000.0*(y - (-287.4))), if(y &gt; -299.5, (-6461400.0 + 21000.0*(y - (-294.0))), if(y &gt; -304.4, (-6576900.0 + 21000.0*(y - (-299.5))), (-6679799.999999999 + 22000.0*(y - (-304.4))))))))))))</expression><expression>if((y &lt; -294.0) and (y &gt; -299.5) and (x &lt; 170.0) and (abs(x - 27.0*round(x/27.0)) &lt; 8.0), 0.0, if(y &gt; -185.9, (0.0 + 22000.0*(y - (0.0))), if(y &gt; -194.4, (-4089800.0 + 22000.0*(y - (-185.9))), if(y &gt; -205.4, (-4276800.0 + 22000.0*(y - (-194.4))), if(y &gt; -287.4, (-4518800.0 + 22000.0*(y - (-205.4))), if(y &gt; -294.0, (-6322799.999999999 + 21000.0*(y - (-287.4))), if(y &gt; -299.5, (-6461400.0 + 21000.0*(y - (-294.0))), if(y &gt; -304.4, (-6576900.0 + 21000.0*(y - (-299.5))), (-6679799.999999999 + 22000.0*(y - (-304.4)))))))))))</expression><expression>if((y &lt; -294.0) and (y &gt; -299.5) and (x &lt; 170.0) and (abs(x - 27.0*round(x/27.0)) &lt; 8.0), 0.0, 0.45*(if(y &gt; -185.9, (0.0 + 22000.0*(y - (0.0))), if(y &gt; -194.4, (-4089800.0 + 22000.0*(y - (-185.9))), if(y &gt; -205.4, (-4276800.0 + 22000.0*(y - (-194.4))), if(y &gt; -287.4, (-4518800.0 + 22000.0*(y - (-205.4))), if(y &gt; -294.0, (-6322799.999999999 + 21000.0*(y - (-287.4))), if(y &gt; -299.5, (-6461400.0 + 21000.0*(y - (-294.0))), if(y &gt; -304.4, (-6576900.0 + 21000.0*(y - (-299.5))), (-6679799.999999999 + 22000.0*(y - (-304.4))))))))))))</expression><expression>0.0</expression>
</parameter>
<parameter><name>E_room</name><type>Function</type><expression>if(t &lt; 315576001.0, 100000.0, 50000000.0)</expression>
</parameter>
<parameter><name>nu_room</name><type>Function</type><expression>if(t &lt; 315576001.0, 0.0, 0.2)</expression>
</parameter>
    </parameters>
    <process_variables>
        <process_variable>
            <name>displacement</name>
            <components>2</components>
            <order>2</order>
            <initial_condition>u0</initial_condition>
            
            <boundary_conditions>
<boundary_condition>
<geometrical_set>toy</geometrical_set>
<geometry>LEFT</geometry><type>Dirichlet</type>
<component>0</component>
<parameter>zero</parameter>
</boundary_condition>
<boundary_condition>
<geometrical_set>toy</geometrical_set>
<geometry>RIGHT</geometry><type>Dirichlet</type>
<component>0</component>
<parameter>zero</parameter>
</boundary_condition>
<boundary_condition>
<geometrical_set>toy</geometrical_set>
<geometry>BOTTOM</geometry><type>Dirichlet</type>
<component>1</component>
<parameter>zero</parameter>
</boundary_condition>
</boundary_conditions>
        </process_variable>
    </process_variables>
    <nonlinear_solvers>
        <nonlinear_solver><name>basic_newton</name><type>Newton</type>
<max_iter>25</max_iter>
        <linear_solver>general_linear_solver</linear_solver>
</nonlinear_solver>
    </nonlinear_solvers>
    <linear_solvers>
        <linear_solver><name>general_linear_solver</name>
        <eigen>
<solver_type>SparseLU</solver_type>
<scaling>true</scaling>
</eigen>
</linear_solver>
    </linear_solvers>
</OpenGeoSysProject>
