<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProject>
    <mesh>cube_1x1x1_hex_1e0.vtu</mesh>
    <geometry>cube_1x1x1.gml</geometry>
    <search_length_algorithm><type>fixed</type><value>1e-6</value>
</search_length_algorithm>
    
    <processes>
        <process>
            <name>SD</name>
            <type>SMALL_DEFORMATION</type>
            <integration_order>2</integration_order>
            <constitutive_relation><type>CreepBGRa</type>
<youngs_modulus>E</youngs_modulus>
<poissons_ratio>nu</poissons_ratio>
<a>A</a>
<n>n</n>
<sigma0>s0</sigma0>
<q>Q</q>
<nonlinear_solver>
<maximum_iterations>200</maximum_iterations>
<residuum_tolerance>1e-6</residuum_tolerance>
<increment_tolerance>1e-9</increment_tolerance>
</nonlinear_solver>
</constitutive_relation>
            <specific_body_force>0.0 0.0 0.0</specific_body_force>
            
            <reference_temperature>T_ref</reference_temperature>
            
            <process_variables>
<process_variable>displacement</process_variable>
</process_variables>
            <secondary_variables>
<secondary_variable name="sigma"/>
<secondary_variable name="epsilon"/>
</secondary_variables>
        </process>
    </processes>
    <time_loop>
        <processes>
            <process ref="SD">
                <nonlinear_solver>basic_newton</nonlinear_solver>
                <convergence_criterion><type>DeltaX</type>
<norm_type>NORM2</norm_type>
<abstol>1e-14</abstol>
<reltol>1e-12</reltol>
</convergence_criterion>
                <time_discretization><type>BackwardEuler</type>
</time_discretization>
                <time_stepping><type>FixedTimeStepping</type>
<t_initial>0.0</t_initial>
<t_end>315576000.0</t_end>
<timesteps>
<pair>
<repeat>40</repeat>
<delta_t>7889400.0</delta_t>
</pair>
</timesteps>
</time_stepping>
            </process>
        </processes>
        <output><type>VTK</type>
<prefix>3D_native_CreepBGRa_Q0</prefix>
<data_mode>Ascii</data_mode>
<compress_output>false</compress_output>
<timesteps>
<pair>
<repeat>40</repeat>
<each_steps>1</each_steps>
</pair>
</timesteps>
<variables>
<variable>displacement</variable>
<variable>sigma</variable>
<variable>epsilon</variable>
</variables>
<suffix>_ts_{:timestep}_t_{:time}</suffix>
</output>
    </time_loop>
    <media>
<medium>
<phases>
<phase><type>Solid</type>
<properties>
<property><name>density</name><type>Constant</type><value>2140.6727828746175</value>
</property>
</properties>
</phase>
</phases>
</medium>
</media>
    <parameters>
        <parameter><name>E</name><type>Constant</type><value>10800000000.0</value>
</parameter>
<parameter><name>nu</name><type>Constant</type><value>0.2</value>
</parameter>
<parameter><name>A</name><type>Constant</type><value>2.4537037037037037e-18</value>
</parameter>
<parameter><name>n</name><type>Constant</type><value>6.5</value>
</parameter>
<parameter><name>s0</name><type>Constant</type><value>1000000.0</value>
</parameter>
<parameter><name>Q</name><type>Constant</type><value>0.0</value>
</parameter>
<parameter><name>T_ref</name><type>Constant</type><value>293.15</value>
</parameter>
<parameter><name>zero</name><type>Constant</type><value>0.0</value>
</parameter>
<parameter><name>u0</name><type>Constant</type><values>0.0 0.0 0.0</values>
</parameter>
<parameter><name>load</name><type>Constant</type><value>-15000000.0</value>
</parameter>
<parameter><name>A2</name><type>Constant</type><value>0.0</value>
</parameter>
<parameter><name>Q2</name><type>Constant</type><value>0.0</value>
</parameter>
<parameter><name>D</name><type>Constant</type><value>1.0</value>
</parameter>
    </parameters>
    <process_variables>
        <process_variable>
            <name>displacement</name>
            <components>3</components>
            <order>1</order>
            <initial_condition>u0</initial_condition>
            
            <boundary_conditions>
<boundary_condition>
<geometrical_set>cube_1x1x1_geometry</geometrical_set>
<geometry>left</geometry><type>Dirichlet</type>
<component>0</component>
<parameter>zero</parameter>
</boundary_condition>
<boundary_condition>
<geometrical_set>cube_1x1x1_geometry</geometrical_set>
<geometry>front</geometry><type>Dirichlet</type>
<component>1</component>
<parameter>zero</parameter>
</boundary_condition>
<boundary_condition>
<geometrical_set>cube_1x1x1_geometry</geometrical_set>
<geometry>bottom</geometry><type>Dirichlet</type>
<component>2</component>
<parameter>zero</parameter>
</boundary_condition>
<boundary_condition>
<geometrical_set>cube_1x1x1_geometry</geometrical_set>
<geometry>top</geometry><type>Neumann</type>
<component>2</component>
<parameter>load</parameter>
</boundary_condition>
</boundary_conditions>
        </process_variable>
    </process_variables>
    <nonlinear_solvers>
        <nonlinear_solver><name>basic_newton</name><type>Newton</type>
<max_iter>30</max_iter>
        <linear_solver>general_linear_solver</linear_solver>
</nonlinear_solver>
    </nonlinear_solvers>
    <linear_solvers>
        <linear_solver><name>general_linear_solver</name>
        <eigen>
<solver_type>SparseLU</solver_type>
<scaling>true</scaling>
</eigen>
</linear_solver>
    </linear_solvers>
</OpenGeoSysProject>
