# Copy to a host-local .env next to compose.yml on CORE (never commit the real file).
# Root of runtime data (canonical Parquet, artifacts, projections, logs, receipts).
VKM_DATA_ROOT=<path-on-host>
# Directory with host-local secrets (outside any repository), mode 700.
VKM_SECRETS_DIR=<path-on-host>
# --- application services (api, mcp, mcp-admin, vkm-job; image built from infra/core/api/Dockerfile) ---
# Owner of the canonical root (the rsync publisher's login user): every app service runs as this uid:gid.
VKM_DATA_UID=<uid>
VKM_DATA_GID=<gid>
# CANONICAL data root on the host (marker, canonical/, artifacts/, duckdb/): read-only for api, read-write for vkm-job.
VKM_DATA_ROOT_HOST=<path-on-host>
VKM_API_IMAGE=vkm-corpus-api:0.1.0
# API and MCP listen on the CORE LAN address only (databases stay on loopback, H-26).
VKM_CORE_LAN_ADDR=<core-lan-address>
VKM_API_PORT=8000
VKM_MCP_PORT=8765
VKM_MCP_ADMIN_PORT=8766
# Host header values MCP clients may send (DNS-rebinding protection; others get 421), comma separated host:port.
VKM_MCP_ALLOWED_HOSTS=<core-lan-name>:8765,<core-lan-address>:8765
VKM_MCP_ADMIN_ALLOWED_HOSTS=<core-lan-name>:8766
# Rerank gateway on EDGE as seen from CORE (empty: rerank endpoints answer DEPENDENCY_UNAVAILABLE).
VKM_RERANK_URL=http://<edge-lan-name>:<port>
# Secret files in VKM_SECRETS_DIR read by the app services — owned by VKM_DATA_UID, mode 0400 (compose file-secrets
# keep the host owner and mode): neo4j_password (bare password), api_read_token, api_write_token, mcp_token,
# mcp_admin_token, rerank_token and the PostgreSQL DSN named below (a copy of pg_dsn owned by VKM_DATA_UID).
# Tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
VKM_APP_PG_DSN_FILE=<file-name-in-secrets-dir>
# Pinned images (tag@digest recorded in the deployment receipt).
VKM_NEO4J_IMAGE=neo4j:5.26.31-community@sha256:5eb12ad77fa46ab73e23df9ea1f43f5c0f2a79523435577648e046be042b9b93
VKM_OPENSEARCH_IMAGE=opensearchproject/opensearch:3.8.0@sha256:fafe3fc3587088674669235575aa166228c48bdb940294a8cdbbc1da75236a40
