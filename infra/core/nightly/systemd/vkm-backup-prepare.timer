# 12:00 Moscow time, every day (moved from 02:00 by the user on 20.10.2026: no night noise): the source manifest is
# ready before EDGE starts copying at 12:30.
[Unit]
Description=VKM backup source manifest at 12:00 MSK

[Timer]
OnCalendar=*-*-* 12:00:00 Europe/Moscow
Persistent=true
AccuracySec=1min
Unit=vkm-backup-prepare.service

[Install]
WantedBy=timers.target
