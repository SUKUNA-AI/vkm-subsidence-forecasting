# 14:00 Moscow time, every day (user decision A3 of 29.09.2026, moved from 04:00 by the user on 20.10.2026); a missed run (host off) starts at the next boot.
[Unit]
Description=VKM nightly checks at 14:00 MSK

[Timer]
OnCalendar=*-*-* 14:00:00 Europe/Moscow
Persistent=true
AccuracySec=1min
Unit=vkm-nightly.service

[Install]
WantedBy=timers.target
