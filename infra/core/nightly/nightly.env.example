# Host-local settings of the VKM nightly jobs on CORE → ~/.config/vkm/nightly.env (install.sh writes it with the
# real paths). No secrets here: tokens stay in the compose secret files. systemd EnvironmentFile syntax: KEY=VALUE,
# comments only on their own lines.
VKM_NIGHTLY_DIR=<COMPOSE_DIR>/nightly
VKM_COMPOSE_DIR=<COMPOSE_DIR>
#
# 04:00 checks (nightly_checks.sh)
# day of the week (1–7, Mon–Sun) of «canon validate --deep»; 0 = never
#VKM_NIGHTLY_DEEP_WEEKDAY=7
# budget_chars of each topic dossier
#VKM_NIGHTLY_DOSSIER_BUDGET=12000
# snapshot directories kept under derived/dossiers/
#VKM_NIGHTLY_DOSSIER_KEEP=5
# days of receipts/nightly/<date>/ kept
#VKM_NIGHTLY_KEEP_DAYS=60
# seconds to wait while a reconcile or a lab refresh runs
#VKM_NIGHTLY_WAIT_BUSY_S=3600
#
# 02:00 source manifest of the backup (backup_prepare.sh)
# late packs in the backup: current | none | all
#VKM_BACKUP_PACKS=current
# hashing threads
#VKM_BACKUP_JOBS=2
#VKM_BACKUP_KEEP_MANIFESTS=7
# day of the month when every file is re-read; 0 = never
#VKM_BACKUP_REHASH_DAY=1
