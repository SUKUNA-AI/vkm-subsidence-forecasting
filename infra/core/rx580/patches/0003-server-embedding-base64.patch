 json server_task_result_embd::to_json_non_oaicompat() {
+    if (b64) {
+        // VKM rx580 patch 0003: token matrices (pooling none) are large; send raw little-endian float32 rows as base64
+        // instead of decimal JSON (≈ 3x smaller, no float formatting/parsing on either side)
+        const size_t n_rows = embedding.size();
+        const size_t n_cols = n_rows ? embedding[0].size() : 0;
+        std::string raw(n_rows * n_cols * sizeof(float), 0);
+        for (size_t r = 0; r < n_rows; ++r) {
+            GGML_ASSERT(embedding[r].size() == n_cols);
+            memcpy(&raw[r * n_cols * sizeof(float)], embedding[r].data(), n_cols * sizeof(float));
+        }
+        return json {
+            {"index",         index},
+            {"embedding_b64", base64::encode(raw.data(), raw.size())},
+            {"n_rows",        n_rows},
+            {"n_cols",        n_cols},
+        };
+    }
     return json {
         {"index",     index},
         {"embedding", embedding},
