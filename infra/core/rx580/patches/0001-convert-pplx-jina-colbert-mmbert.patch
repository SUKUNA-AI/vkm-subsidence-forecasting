+    def _is_metaspace_bpe(self) -> bool:
+        tokenizer_json = self.dir_model / "tokenizer.json"
+        if not tokenizer_json.is_file():
+            return False
+        with open(tokenizer_json, "r", encoding="utf-8") as f:
+            tj = json.load(f)
+        pre = tj.get("pre_tokenizer") or {}
+        model = tj.get("model") or {}
+        return pre.get("type") == "Metaspace" and model.get("type") == "BPE" and bool(model.get("byte_fallback"))
