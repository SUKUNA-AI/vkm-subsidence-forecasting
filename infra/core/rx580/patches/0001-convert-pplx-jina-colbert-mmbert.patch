+@ModelBase.register("PPLXQwen3Model", "Qwen3BidirectionalModel")
+@ModelBase.example("perplexity-ai/pplx-embed-v1-0.6b")
+class PPLXQwen3Model(Qwen3Model):
+    """VKM rx580 patch 0001: Perplexity pplx-embed-v1 family (dense, context, late): Qwen3 weights with bidirectional
+    attention (PPLXQwen3Model sets is_causal=False on every layer); pooling from 1_Pooling when present."""
+    model_arch = gguf.MODEL_ARCH.QWEN3
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        self.gguf_writer.add_causal_attention(False)
+
+    def set_vocab(self):
+        try:
+            super().set_vocab()
+        except NotImplementedError as exc:
+            # Giga-Embeddings ships an o200k-style BPE whose pre-tokenizer hash is unknown to this converter. The VKM
+            # service always sends token ids produced by the pinned tokenizer.json, so the GGUF vocabulary is only
+            # structural here: write it with the "default" pre-tokenizer and say so.
+            logger.warning(f"VKM: unknown BPE pre-tokenizer ({exc}); writing pre=default (id-based use only)")
+            self.get_vocab_base_pre = lambda tokenizer: "default"  # ty: ignore[invalid-assignment]
+            self._set_vocab_gpt2()
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        if not name.startswith("model.") and not name.startswith("lm_head"):
+            name = f"model.{name}"  # PPLXQwen3Model is a bare Qwen3Model: map to Qwen3ForCausalLM tensor names
+        yield from super().modify_tensors(data_torch, name, bid)
+
+
