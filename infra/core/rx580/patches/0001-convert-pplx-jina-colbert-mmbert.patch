+@ModelBase.register("HF_ColBERT")
+@ModelBase.example("jinaai/jina-colbert-v2")
+class JinaColBertV2Model(XLMRobertaModel):
+    """VKM rx580 patch 0001: jinaai/jina-colbert-v2 backbone = XLM-RoBERTa with rotary positions (the
+    jina-embeddings-v3 architecture without LoRA adapters). The ColBERT head (linear.weight, 1024->128, no bias) and
+    the unused pooler are not stored: the VKM gateway applies the head to the token outputs (pooling none)."""
+    model_arch = gguf.MODEL_ARCH.JINA_BERT_V3
+
+    @classmethod
+    def filter_tensors(cls, item: tuple[str, Callable[[], Tensor]]) -> tuple[str, Callable[[], Tensor]] | None:
+        name, _ = item
+        if name == "linear.weight" or ".pooler." in name or name.startswith("pooler."):
+            return None
+        return super().filter_tensors(item)
