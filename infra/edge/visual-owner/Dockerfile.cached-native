# Explicit immutable cache derivation. Cold Dockerfile remains the rebuild recipe.
ARG PYTHON_IMAGE=python:3.13-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26
ARG CUDA_RUNTIME_IMAGE=nvidia/cuda:13.2.1-runtime-ubuntu24.04@sha256:4c17c2e7474ca1d470428b25e87e95756f51e7da3b663859894a03bc5a7ebdae
FROM ${PYTHON_IMAGE} AS python

# This exact owned image was cold-built from pinned 4da source and 3 base pins.
FROM sha256:c0c0280b8f59e040fadaba3f14bea0f9d8dae93c86fd9de7ca76f8203006609a AS native
ARG PUBLIC_SOURCE_COMMIT
ARG BUILD_INPUTS_SHA256
LABEL vkm.owner.stage="cached-native-builder" vkm.owner-qualification="20261004-native-owners" \
      vkm.owner.public-source="${PUBLIC_SOURCE_COMMIT}" vkm.owner.inputs-sha256="${BUILD_INPUTS_SHA256}"
COPY --from=python /usr/local/ /usr/local/
ENV LD_LIBRARY_PATH=/usr/local/lib:/out:/usr/local/cuda/lib64 PYTHONDONTWRITEBYTECODE=1
COPY verify_native_cache.py /opt/verify-native-cache.py
COPY native-cache-plan.json /opt/native-cache-plan.json
ARG NATIVE_CACHE_PLAN_SHA256
RUN test "$(cat /sys/fs/cgroup/memory.max)" = "8589934592" \
 && test "$(cat /sys/fs/cgroup/memory.swap.max)" = "0" \
 && test "$(cat /sys/fs/cgroup/cpu.max)" = "200000 100000" \
 && printf '%s\n' 'memory.max=8589934592' 'memory.swap.max=0' 'cpu.max=200000 100000' > /BUILD_CGROUP_LIMITS.txt \
 && python -I /opt/verify-native-cache.py --plan /opt/native-cache-plan.json --plan-sha256 "${NATIVE_CACHE_PLAN_SHA256}" --phase before > /CACHE_BEFORE.json
COPY native-delta/server-context.cpp /src/tools/server/server-context.cpp
COPY vkm-loaded-lifetime.h /src/tools/server/vkm-loaded-lifetime.h
COPY vkm-weight-placement.h /src/tools/server/vkm-weight-placement.h
RUN python -I /opt/verify-native-cache.py --plan /opt/native-cache-plan.json --plan-sha256 "${NATIVE_CACHE_PLAN_SHA256}" --phase after-overlay > /CACHE_AFTER_OVERLAY.json \
 && touch /src/tools/server/server-context.cpp /src/tools/server/vkm-loaded-lifetime.h /src/tools/server/vkm-weight-placement.h \
 && timeout 180s nice -n 10 cmake --build /src/build -j2 --target llama-server \
 && python -I /opt/verify-native-cache.py --plan /opt/native-cache-plan.json --plan-sha256 "${NATIVE_CACHE_PLAN_SHA256}" --phase after-overlay > /CACHE_AFTER_BUILD.json \
 && mkdir /new-out && cp /src/build/bin/llama-server /BUILD_CGROUP_LIMITS.txt /CACHE_BEFORE.json /CACHE_AFTER_OVERLAY.json /CACHE_AFTER_BUILD.json /opt/native-cache-plan.json /new-out/ \
 && find /src/build -name '*.so*' -exec cp -P '{}' /new-out/ ';' \
 && cd /new-out && sha256sum llama-server *.so* > SHA256SUMS

FROM ${CUDA_RUNTIME_IMAGE}
ARG PUBLIC_SOURCE_COMMIT
ARG BUILD_INPUTS_SHA256
LABEL vkm.owner.stage="cached-runtime-builder" vkm.owner-qualification="20261004-native-owners" \
      vkm.owner.public-source="${PUBLIC_SOURCE_COMMIT}" vkm.owner.inputs-sha256="${BUILD_INPUTS_SHA256}"
COPY runtime-debs/ /debs/
RUN set -eu; cd /debs; sha256sum -c SHA256SUMS; set -- /debs/*.deb; if [ -f "$1" ]; then dpkg -i "$@"; fi
COPY --from=python /usr/local/ /usr/local/
COPY --from=native /new-out/ /app/
ENV LD_LIBRARY_PATH=/usr/local/lib:/app:/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -I -c "import platform,ssl,bz2,lzma,sqlite3,ctypes,readline,uuid; assert platform.python_version()=='3.13.15'; assert ssl.OPENSSL_VERSION_INFO[0]==3; assert sqlite3.connect(':memory:').execute('select 1').fetchone()==(1,); assert bz2.decompress(bz2.compress(b'abi'))==b'abi'; assert lzma.decompress(lzma.compress(b'abi'))==b'abi'"
COPY wheelhouse/ /opt/owner-wheels/
COPY dependencies.lock.txt vkm_world-0.1.0-py3-none-any.whl /opt/owner-wheels/
COPY gpu_preflight.py /opt/vkm-gpu-preflight.py
RUN python -m pip install --no-index --find-links=/opt/owner-wheels --require-hashes -r /opt/owner-wheels/dependencies.lock.txt \
 && python -m pip install --no-index --no-deps /opt/owner-wheels/vkm_world-0.1.0-py3-none-any.whl \
 && python -m pip check \
 && python -I -c "import vkm_corpus.update.visual_owner_bridge,vkm_corpus.update.visual_placement; import numpy,pydantic,httpx; assert numpy.__version__=='2.5.3'; assert pydantic.__version__=='2.13.5'; assert httpx.__version__=='0.28.1'" \
 && python -m pip freeze > /opt/owner-wheels/installed-versions.txt
RUN ldd /app/llama-server > /app/LDD_SERVER.txt && ! grep -F 'not found' /app/LDD_SERVER.txt \
 && /app/llama-server --version > /app/NATIVE_VERSION.txt
ARG PUBLIC_SOURCE_COMMIT
ARG BUILD_INPUTS_SHA256
ARG NATIVE_CACHE_PLAN_SHA256
LABEL vkm.owner.role="native-visual-gpu-owner" vkm.owner.qualification="NOT_RUN" \
      vkm.owner.public-source="${PUBLIC_SOURCE_COMMIT}" vkm.owner.inputs-sha256="${BUILD_INPUTS_SHA256}" \
      vkm.owner.native-cache="sha256:c0c0280b8f59e040fadaba3f14bea0f9d8dae93c86fd9de7ca76f8203006609a" \
      vkm.owner.native-cache-plan="${NATIVE_CACHE_PLAN_SHA256}" \
      vkm.owner.llama-source="4da6337767f973e2b4d0797e5b323d77d8565e4a"
USER 10001:10001
ENTRYPOINT ["python", "/opt/vkm-gpu-preflight.py"]
