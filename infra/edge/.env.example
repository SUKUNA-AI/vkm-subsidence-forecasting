# Copy to a host-local .env next to compose.yml on EDGE (the real file is never committed).
# Root of EDGE data: models (weights, tokenizers, mmproj, score head), secrets, logs, receipts.
VKM_EDGE_ROOT=<path-on-host>
# LAN address the gateway listens on (besides 127.0.0.1); the VKM API on CORE calls http://<this>:18084.
VKM_EDGE_LAN_ADDR=<lan-address-of-edge>
# Images built on EDGE by build_images.sh (record tag and image id in the deployment receipt).
# m0 = visual-owner image (exact local image ID; built by the owner pipeline, see infra/edge/visual-owner).
VKM_RERANK_LLAMA_IMAGE=sha256:<visual-owner-image-id>
# Host-local owner control root (recipe.json, identity.token, helper) and its approved pins.
VKM_VISUAL_OWNER_CONTROL_ROOT=<path-on-host>
VKM_VISUAL_OWNER_RECIPE_SHA256=<sha256 of recipe.json>
VKM_VISUAL_OWNER_WORKLOAD_BINDING_SHA256=<sha256 of the LIVE workload binding>
VKM_RERANK_GATEWAY_IMAGE=vkm/rerank-gateway:0.1.1
# Placement of jina-reranker-m0 Q6_K: LLM layers on GPU (of 28); mmproj always on GPU, output layer on CPU.
VKM_RERANK_M0_NGL=20
VKM_RERANK_M0_FA=on
VKM_RERANK_M0_QUANT=Q6_K
# Non-empty only if the deployment deviates from Q6_K / the planned placement (shown in /status and responses).
VKM_RERANK_M0_DEVIATION=
# Text backend: the service runs inference under one lock → no gateway limit (H-41); 0 = unlimited.
VKM_RERANK_TEXT_MAX_INFLIGHT=0
