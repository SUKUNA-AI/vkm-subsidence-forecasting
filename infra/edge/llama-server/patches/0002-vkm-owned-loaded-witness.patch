+json server_context::get_loaded_witness(const std::string & nonce) const {
+    if (!vkm::nonce_valid(nonce)) throw std::invalid_argument("invalid witness nonce");
+    const auto state = impl->vkm_lifetime.snapshot([this]() {
+        vkm::loaded_handles value;
+        value.model = reinterpret_cast<std::uintptr_t>(impl->model_tgt);
+        value.context = reinterpret_cast<std::uintptr_t>(impl->ctx_tgt);
+        value.mmproj = reinterpret_cast<std::uintptr_t>(impl->mctx);
+        if (impl->model_tgt && impl->ctx_tgt && llama_get_model(impl->ctx_tgt) == impl->model_tgt) {
+            value.vocab = reinterpret_cast<std::uintptr_t>(llama_model_get_vocab(impl->model_tgt));
+        }
+        value.weights_path = impl->params_base.model.path;
+        value.mmproj_path = impl->params_base.mmproj.path;
+        return value;
+    });
+    return {{"schema_version", "vkm-native-loaded-witness/1"},
+        {"upstream_commit", "4da6337767f973e2b4d0797e5b323d77d8565e4a"},
+        {"nonce", nonce}, {"epoch", state.epoch}, {"capture_before_load", true},
+        {"handles", {{"model", state.model}, {"context", state.context},
+            {"mmproj", state.mmproj}, {"vocab", state.vocab}}},
+        {"paths", {{"weights", state.weights_path}, {"tokenizer", state.weights_path},
+            {"mmproj", state.mmproj_path}}}};
+}
+
 server_response_reader server_context::get_response_reader() {
     return impl->get_response_reader();
 }
