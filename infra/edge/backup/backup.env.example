# Host-local settings of the VKM backup on EDGE → ~/.config/vkm/backup.env (install.sh writes it with the real
# paths). No secrets here: the SSH key lives in ~/.ssh and CORE restricts it (vkm_backup_gate.sh). systemd
# EnvironmentFile syntax: KEY=VALUE, quotes around values with spaces, comments only on their own lines.
VKM_BACKUP_ROOT=<VKM_EDGE_ROOT>/backup
VKM_BACKUP_BIN=<VKM_EDGE_ROOT>/backup/bin
# ssh alias of CORE (~/.ssh/config: HostName, User, IdentityFile of the backup key, IdentitiesOnly yes); through the
# gate on CORE "vkm-core-backup:/" is the data root (pull) and receipts/backup/edge/ (status push)
VKM_BACKUP_SOURCE=vkm-core-backup:/
#VKM_BACKUP_STATUS_DEST=vkm-core-backup:/
# retention of hard-link snapshots: the newest per day / ISO week / month, and never fewer than KEEP_MIN
VKM_BACKUP_KEEP_DAILY=7
VKM_BACKUP_KEEP_WEEKLY=4
VKM_BACKUP_KEEP_MONTHLY=6
VKM_BACKUP_KEEP_MIN=3
# keep at least this much free on the EDGE file system (the oldest snapshots go first); the budget is reported
VKM_BACKUP_MIN_FREE_GB=100
VKM_BACKUP_BUDGET_GB=180
# on this weekday (7 = Sunday): rsync --checksum and a full re-hash of the new snapshot (bit rot); 0 = never
VKM_BACKUP_REHASH_WEEKDAY=7
VKM_BACKUP_JOBS=2
# bandwidth limit in KiB/s (empty = the full link)
#VKM_BACKUP_BWLIMIT=60000
#VKM_BACKUP_MANIFEST_MAX_AGE_H=20
#VKM_BACKUP_WAIT_MANIFEST_S=2700
