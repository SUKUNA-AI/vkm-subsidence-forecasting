# 12:30 Moscow time, every day (user decision A2 of 29.09.2026, moved from 02:30 by the user on 20.10.2026): after the
# CORE manifest (12:00), before the CORE checks (14:00) that report this backup; a missed run (laptop off) starts at the next boot.
[Unit]
Description=VKM backup of CORE at 12:30 MSK

[Timer]
OnCalendar=*-*-* 12:30:00 Europe/Moscow
Persistent=true
AccuracySec=1min
Unit=vkm-backup.service

[Install]
WantedBy=timers.target
