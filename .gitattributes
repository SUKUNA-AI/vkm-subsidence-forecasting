* text=auto
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
requirements/*.in text eol=lf
requirements/*.txt text eol=lf

# Source archives and binary research artifacts are versioned through Git LFS.
*.zip filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.xls filter=lfs diff=lfs merge=lfs -text
*.gpkg filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text

# Intentionally versioned model/data binaries must never become ordinary Git blobs.
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.feather filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text

# Preserve every byte covered by the delivered manifests/checksums.
CHANGELOG_v2.md -text -eol
README_FIRST.md -text -eol
BUNDLE_MANIFEST.csv -text -eol
CHECKSUMS.sha256 -text -eol
codex/** -text -eol
configs/** -text -eol
docs/governance/** -text -eol
docs/user/** -text -eol
inputs/** -text -eol
repo_bootstrap/** -text -eol
scripts/bootstrap_repo.ps1 -text -eol
scripts/bootstrap_repo.sh -text -eol
scripts/verify_inputs.py -text -eol
SKRU1_ACTUAL_DATA_TABLES_v1/** -text -eol
data/reconstruction_research_v1/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Scenario v2 freeze: retain exact bytes referenced by release manifests.
# The v1 data/code below are immutable dependencies and the differential baseline.
.gitattributes text eol=lf
data/scenario_simulation_v1/** -text -eol
data/scenario_simulation_v2/** -text -eol
artifacts/reconstruction/scenario_constraints_v2/** -text -eol
artifacts/data_quality/scenario_simulation_v2/** -text -eol
artifacts/data_quality/scenario_simulation_v2_freeze/** -text -eol
src/skru1/scenario_simulation.py -text -eol
src/skru1/empirical_constraints_v2.py -text -eol
src/skru1/scenario_simulation_v2.py -text -eol
scripts/generate_scenario_v1.py -text -eol
scripts/build_scenario_constraints_v2.py -text -eol
scripts/generate_scenario_v2.py -text -eol
scripts/audit_scenario_v2.py -text -eol
scripts/validate_scenario_v2.py -text -eol
scripts/build_data_foundation_v2_report.py -text -eol
scripts/finalize_data_foundation_v2.py -text -eol
scripts/recheck_scenario_v2_release.py -text -eol
tests/test_data_foundation_v2.py -text -eol
docs/reports/DATA_FOUNDATION_V2_RU.md -text -eol
docs/reports/DATA_FOUNDATION_V2_RU.html -text -eol
docs/reports/IMM_V2_IMPROVEMENT_DESIGN_RU.md -text -eol
docs/reports/SCENARIO_SIMULATION_V2_FREEZE_RU.md -text -eol

# Existing binary-data LFS policy, scoped to these compressed release tables.
data/scenario_simulation_v1/**/*.gz filter=lfs diff=lfs merge=lfs -text -eol
data/scenario_simulation_v1/*.gz filter=lfs diff=lfs merge=lfs -text -eol
data/scenario_simulation_v2/**/*.gz filter=lfs diff=lfs merge=lfs -text -eol
data/scenario_simulation_v2/*.gz filter=lfs diff=lfs merge=lfs -text -eol

# CRLF in hashed receipts is intentional; do not rewrite it to satisfy diff QA.
artifacts/data_quality/scenario_simulation_v2/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
artifacts/data_quality/scenario_simulation_v2_freeze/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
configs/scenario*_v2.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/reports/DATA_FOUNDATION_V2_RU.* whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
src/skru1/scenario_simulation_v2.py whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
