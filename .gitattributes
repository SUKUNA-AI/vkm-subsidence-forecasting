* text=auto
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
requirements/*.in text eol=lf
requirements/*.txt text eol=lf

# Source archives and binary research artifacts are versioned through Git LFS.
*.zip filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.xls filter=lfs diff=lfs merge=lfs -text
*.gpkg filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text

# Intentionally versioned model/data binaries must never become ordinary Git blobs.
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.feather filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text

# Preserve every byte covered by the delivered manifests/checksums.
CHANGELOG_v2.md -text -eol
README_FIRST.md -text -eol
BUNDLE_MANIFEST.csv -text -eol
CHECKSUMS.sha256 -text -eol
codex/** -text -eol
configs/** -text -eol
docs/governance/** -text -eol
docs/user/** -text -eol
inputs/** -text -eol
repo_bootstrap/** -text -eol
scripts/bootstrap_repo.ps1 -text -eol
scripts/bootstrap_repo.sh -text -eol
scripts/verify_inputs.py -text -eol
SKRU1_ACTUAL_DATA_TABLES_v1/** -text -eol
